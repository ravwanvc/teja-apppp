{
  "name": "teja",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:project": "node scripts/check-project.mjs",
    "test": "node --no-warnings tests/mongodb-schema.mjs && node scripts/check-project.mjs",
    "test:mongo": "node tests/mongodb-schema.mjs",
    "admin:setup": "node scripts/admin-setup.mjs",
    "admin:check": "node scripts/admin-check.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "preview:export": "node scripts/export-preview.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "mongodb": "^6.12.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.6.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "npm@11.9.0"
}
